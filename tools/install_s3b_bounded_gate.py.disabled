from pathlib import Path
import re
import shutil


ROOT = Path(".")
ARGS_PATH = ROOT / "args.py"
SEG_PATH = ROOT / "lib" / "segmentation.py"


def backup_file(path):
    backup = path.with_suffix(path.suffix + ".pre_s3b")

    if not backup.exists():
        shutil.copy2(str(path), str(backup))
        print("Backup created:", backup)
    else:
        print("Backup already exists:", backup)


def patch_args():
    text = ARGS_PATH.read_text(encoding="utf-8")

    if "--use-bounded-gated-refine" in text:
        print("args.py already contains S3-B argument.")
        return

    pattern = re.compile(
        r'^(?P<indent>\s*)parser\.add_argument\(\s*'
        r'["\']--use-small-refine["\']',
        re.MULTILINE,
    )

    match = pattern.search(text)

    if match is None:
        raise RuntimeError(
            "Could not find --use-small-refine in args.py"
        )

    indent = match.group("indent")

    addition = (
        indent +
        "parser.add_argument("
        "'--use-bounded-gated-refine', "
        "action='store_true', "
        "help='use S3-B bounded gated high-resolution refinement'"
        ")\n"
    )

    text = text[:match.start()] + addition + text[match.start():]
    ARGS_PATH.write_text(text, encoding="utf-8")

    print("Patched:", ARGS_PATH)


def leading_spaces(line):
    return len(line) - len(line.lstrip(" "))


def patch_segmentation():
    text = SEG_PATH.read_text(encoding="utf-8")

    import_line = (
        "from lib.bounded_gated_small_refinement import "
        "BoundedGatedHighResolutionSmallRefinement\n"
    )

    if import_line not in text:
        anchor = (
            "from lib.high_resolution_small_refinement import "
            "HighResolutionSmallRefinement"
        )

        position = text.find(anchor)

        if position < 0:
            raise RuntimeError(
                "Could not find HighResolutionSmallRefinement import "
                "in lib/segmentation.py"
            )

        line_end = text.find("\n", position)

        if line_end < 0:
            line_end = len(text) - 1

        text = (
            text[:line_end + 1] +
            import_line +
            text[line_end + 1:]
        )

    if "S3-B bounded gated high-resolution refinement enabled" in text:
        SEG_PATH.write_text(text, encoding="utf-8")
        print("lib/segmentation.py already contains S3-B branch.")
        return

    lines = text.splitlines(keepends=True)

    condition_pattern = re.compile(
        r'^(?P<indent>\s*)if\s+'
        r'(?:'
        r'getattr\(\s*args\s*,\s*["\']use_small_refine["\'].*\)'
        r'|'
        r'args\.use_small_refine'
        r')'
        r'\s*:\s*$'
    )

    block_start = None
    block_indent = None

    for index, line in enumerate(lines):
        match = condition_pattern.match(line.rstrip("\n"))

        if match is not None:
            block_start = index
            block_indent = len(match.group("indent"))
            break

    if block_start is None:
        raise RuntimeError(
            "Could not find the S2 use_small_refine conditional block "
            "in lib/segmentation.py"
        )

    block_end = len(lines)

    for index in range(block_start + 1, len(lines)):
        stripped = lines[index].strip()

        if not stripped:
            continue

        if leading_spaces(lines[index]) <= block_indent:
            block_end = index
            break

    original_block = "".join(lines[block_start:block_end])

    s3b_block = original_block

    original_first_line = lines[block_start]
    indent = " " * block_indent

    s3b_first_line = (
        indent +
        'if getattr(args, "use_bounded_gated_refine", False):\n'
    )

    first_newline = s3b_block.find("\n")
    s3b_block = (
        s3b_first_line +
        s3b_block[first_newline + 1:]
    )

    s3b_block = s3b_block.replace(
        "HighResolutionSmallRefinement",
        "BoundedGatedHighResolutionSmallRefinement",
    )

    s3b_block = s3b_block.replace(
        "S2 high-resolution small-object refinement enabled",
        "S3-B bounded gated high-resolution refinement enabled",
    )

    # Original S2 branch becomes elif.
    original_condition = (
        indent +
        'elif getattr(args, "use_small_refine", False):\n'
    )

    original_first_newline = original_block.find("\n")
    original_block = (
        original_condition +
        original_block[original_first_newline + 1:]
    )

    replacement = s3b_block + original_block

    lines[block_start:block_end] = [replacement]

    SEG_PATH.write_text(
        "".join(lines),
        encoding="utf-8",
    )

    print("Patched:", SEG_PATH)


def main():
    for path in [ARGS_PATH, SEG_PATH]:
        if not path.exists():
            raise FileNotFoundError(str(path))
        backup_file(path)

    patch_args()
    patch_segmentation()

    print("\nS3-B installation completed.")


if __name__ == "__main__":
    main()
